
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Products {
  id Int @id @default(autoincrement())
  name String @unique 
  price Float
  available Boolean @default(true)

  createdAt DateTime@default(now())
  updatedAt DateTime@updatedAt

  @@index([available])
}